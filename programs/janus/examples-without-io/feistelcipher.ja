procedure allRounds(stack roundKey,stack blocksLeft,stack blocksRight)
    local int i=0
    from i = 0
	do
	    call round(roundKey,blocksLeft,blocksRight)
    	    call newRoundKey(roundKey)
	    i+=1
      until i=8
	    call round(roundKey,blocksLeft,blocksRight)

     delocal int i =8
procedure main()
    int key[8]
    int block[8]

    int endKey[8]
    int cipherBlock[8]

    int block32_1[32]
    int block32_2 [32]

    int key64 [64]

    stack roundKey
    stack blocks
    stack blocksLeft
    stack blocksRight


    key[0]+=1
    key[1]+=2
    key[2]+=3
    key[3]+=4
    key[4]+=5
    key[5]+=6
    key[6]+=7
    key[7]+=8



    block[0]+=1
    block[1]+=2
    block[2]+=3
    block[3]+=4
    block[4]+=5
    block[5]+=6
    block[6]+=7
    block[7]+=8
   


call convertBlockAndKeyToBitArrays( key, block, block32_1, block32_2, key64 )

call putBlocksAndKeyOnStacks(block32_1,block32_2, key64, roundKey, blocksLeft, blocksRight)

//calls the round procedure of the feistel network
// modifies the roundkey
call allRounds(roundKey, blocksLeft, blocksRight) 


uncall putBlocksAndKeyOnStacks(block32_1,block32_2, key64, roundKey, blocksLeft, blocksRight)

uncall convertBlockAndKeyToBitArrays( endKey, cipherBlock, block32_1, block32_2, key64 )

//call writeBlockAndKey(cipherBlock,endKey)





//from this point onwards, the ciphertext is deciphered using uncall of the round procedure.



//    L_i+1=R_i,
//    R_i+1 = L_i ⊕ F ( R_i , K_i ) 


procedure round(stack roundkey, stack blocksLeft, stack blocksRight)



     local int i=0
     local int li1=0
     local int ri=0
     local int li=0
     local int ri1=0
     local stack tmpStackLi1=nil
     local stack tmpStackRi=nil
     local stack tmpKey=nil
     local int key=0


	from    i = 0


     //sets li+1 to ri, ri is then cached on tmpstackri, li1 is cached on tmpli1

	do   

		pop(li,blocksLeft)
		pop(ri,blocksRight)
		pop(key, roundkey)

		//the new value of li is in this case the same as ri+1
		//this acts as the feistelnetwork procedure
		//therefore the key needs to be involved aswell
		call feistel(li,ri,key)
		//li^=ri ^ key
		
		//push ri+1 on tmpStackRi
		push(li,tmpStackRi)
		push(key,tmpKey)

		//push li+1 on tmpStackLi1
		push(ri,tmpStackLi1)
		i+=1

	until   i = 32
 	i-=32

     from    i = 0
//puts the round key back on the stack in the correct order
    do  

	    pop(key,tmpKey)
	    push(key,roundkey)

	    i+=1
    until   i = 32


	i-=32


//legt die werte von ri+1 und li+1 wieder korrekt auf die jeweiligen block stacks
     from    i = 0
    do
	pop(ri1,tmpStackRi)
	push(ri1, blocksRight)
	pop(li, tmpStackLi1)
	push(li, blocksLeft)
	   
      i+=1
    until   i = 32
      i-=32

//end of round

	delocal int key=0
     	delocal stack tmpKey=nil
        delocal stack tmpStackRi=nil
        delocal stack tmpStackLi1=nil
        delocal int ri1=0
        delocal int li=0
        delocal int ri=0
        delocal int li1=0
	delocal int i = 0


//a simple, linear feistel function
procedure feistel(int li, int ri, int key)
	li^=ri ^ key



procedure shiftLeft(int n, int amount)
    local int i = 0
    from i = 0 do
        i += 1
        local int nTimesTwo = n * 2
        n <=> nTimesTwo
        delocal int nTimesTwo = n / 2
    until i = amount
    delocal int i = amount



//shifts the round key by one byte
procedure newRoundKey(stack roundKey)
	local stack tmpkey1= nil
	local stack tmpkey2 = nil
	local int i= 0
	local int key=0	

	from i=0
	do 
		pop(key,roundKey)
		push(key,tmpkey1)
		i+=1
	until i=8

	i-=8



	from i=0
	do 
		pop(key,roundKey)
		push(key,tmpkey2)
		i+=1
	until i=56

	i-=56
	from i= 0
	do 
		pop(key,tmpkey1)
		push(key,roundKey)
		i+=1
	until i=8

	i-=8

	from i= 0
	do
		pop(key,tmpkey2)
		push(key,roundKey)
		i+=1
	until i = 56		
	i-=56


	delocal int key= 0
	delocal int i = 0
	delocal stack tmpkey2 = nil
	delocal stack tmpkey1= nil




procedure convertBlockAndKeyToBitArrays(int key[8],int block[8],int block32_1[32],int block32_2 [32],int key64 [64])
    local int j = 0
    local int k = 7
    local int j2 = 0

    // "converts" the first half of the key array into a 64-bit array
	// converts the the left half of the block array into a 32-bit array
    from  j = 0
    do  call bits64(key[k],j,key64)

	  call bits32(block[k],j, block32_2)
	  j+=8
	  k-=1

    until j = 32

	j-=32
	from j=0
	do 
	j+=1
	until j=32
// "converts" the second half of the key array into a 64-bit array
// converts the the right half of the block array into a 32-bit array
    from  j = 32

    do  call bits64(key[k],j,key64)

	  call bits32(block[k],j2, block32_1)
	  j2+=8
          j+=8
	  k-=1

    until j = 64



    delocal int j2 = 32
    delocal int k = -1
    delocal int j = 64


procedure writeBlockAndKey(int block[8], int key[8])
local int j= 0


	from j=0
	do
		//write(block[j])
		j+=1
	until j=8

	j-=8

	from j=0
	do
		//write(key[j])
		j+=1
	until j=8
delocal int j = 8


procedure putBlocksAndKeyOnStacks(int block32_1[32],int block32_2 [32],int key64 [64],stack roundKey, stack blocksLeft, stack blocksRight)
     local int i=0
     from    i = 0
    do   

	       if i < 32 then

	  	push(block32_1[i],blocksLeft)
	  	push(block32_2[i],blocksRight)
		fi i < 32

	push(key64[i],roundKey)


	i+=1
    until   i = 64

    delocal int i = 64


procedure divBy(int divisor, int n, int remainder)
    remainder += n % divisor

    local   int h = (n - remainder) / divisor
    n <=> h
    delocal int h = n * divisor + remainder


procedure bits64(int input, int start, int byte[64])
    local   int two = 2
    local   int i = start


    from    i = start
    do      call divBy(two, input, byte[64 - (i + 1)])
            i += 1
    until   i = start+8
    delocal int i = start+8
    delocal int two = 2



procedure bits32(int input, int start, int byte[32])
    local   int two = 2
    local   int i = start
 


    from    i = start
    do      call divBy(two, input, byte[32 - (i + 1)])
            i += 1
    until   i = start+8

    delocal int i = start+8
    delocal int two = 2

