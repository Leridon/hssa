
// A test program used to demonstrate how simple, fixed-length strings can be represented.

procedure main()
    int message[12]

    message[ 0] ^= 'H'
    message[ 1] ^= 'e'
    message[ 2] ^= 'l'
    message[ 3] ^= 'l'
    message[ 4] ^= 'o'
    message[ 5] ^= ' '
    message[ 6] ^= 'W'
    message[ 7] ^= 'o'
    message[ 8] ^= 'r'
    message[ 9] ^= 'l'
    message[10] ^= 'd'
    message[11] ^= '!'
