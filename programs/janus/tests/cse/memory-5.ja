// Expected results:
// A = [0, 0, 0, 6, 0, 0, 0, 0, 0, 0]
// x = 163
// y = 45

procedure main()
    int A[10]
    int x
    int y

    A[3] += 1
    call memoryReadAndWrite(A, x, y)


procedure memoryReadAndWrite(int A[10], int x, int y)
    local int a = 3
        x += A[3] * 7 + 2 + A[3] * 7
        x += A[3] * 7 + 2 + A[3] * 7
        A[3] += 5
        y += A[3] * 7 + a
        x += A[3] * 7 + 2 + A[3] * 7 + y
    delocal int a = 3
