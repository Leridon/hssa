// x = 267
// y = 1188

procedure main()
    int x
    int y

    x += 3
    y += 12

    local int a = 13
    call circularArithmetic(x, y, a)
    delocal int a = 13

procedure circularArithmetic(int x, int y, int b)
    x += y * 2
    y += 2 * x + 2 * x
    x += y * 2
    y += 2 * x + 2 * x
