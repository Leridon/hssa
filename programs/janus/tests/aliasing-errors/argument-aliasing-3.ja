////////////////////////////////////////////////////////////////////////
// This file is used to test, whether the compiler correctly detects
// semantic errors in an input file.
//
// argument-aliasing-3.ja:
//      It is not allowed to pass the same argument as two different
//      names to a procedure.
//
// N. Deworetzki, 22. Sep. 2020
////////////////////////////////////////////////////////////////////////

procedure f(int a, int b)
    a -= b

procedure main()
    int notAllowed[2]

    call f(notAllowed[0], notAllowed[0])