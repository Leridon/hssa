////////////////////////////////////////////////////////////////////////
// This file is used to test, whether the compiler correctly detects
// semantic errors in an input file.
//
// type-required-int2.ja:
//      The variable of a push-statement must be an integer.
//
// N. Deworetzki, 04. Mar. 2020
////////////////////////////////////////////////////////////////////////

procedure main()
    stack notAnInteger

    push(notAnInteger, notAnInteger)