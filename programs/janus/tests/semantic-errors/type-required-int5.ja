////////////////////////////////////////////////////////////////////////
// This file is used to test, whether the compiler correctly detects
// semantic errors in an input file.
//
// type-required-int5.ja:
//      The variable passed as the target of a read statement must be
//      an integer.
//
// N. Deworetzki, 04. Mar. 2020
////////////////////////////////////////////////////////////////////////

procedure main()
    stack notAnInteger

    read(notAnInteger)