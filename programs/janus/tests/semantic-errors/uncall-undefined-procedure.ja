// uncall-undefined-procedure.ja:
//      When a procedure is uncalled by it's name, there must actually
//      exist a procedure with said name.
//
// N. Deworetzki, 04. Mar. 2020
////////////////////////////////////////////////////////////////////////

procedure main()

    uncall undefinedProcedure()