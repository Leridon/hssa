// This file is used to test, whether the compiler correctly detects
// semantic errors in an input file.
//
// call-not-enough-arguments.ja:
//      The amount of arguments passed to a procedure must match with
//      the amount of parameters defined.
//
// N. Deworetzki, 03. Mar. 2020
////////////////////////////////////////////////////////////////////////

procedure main()
    int a
    int b
    call withThreeArguments(a, b)

procedure withThreeArguments(int a, int b, int c)
    skip