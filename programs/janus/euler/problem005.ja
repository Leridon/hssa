// Problem 5 – Smallest multiple
// 2520 is the smallest number that can be divided by each of the numbers from 1 to 10 without any remainder.
// What is the smallest positive number that is evenly divisible by all of the numbers from 1 to 20?

procedure main()
    stack garbage
    int smallestMultiple

    smallestMultiple += 1

    local int tmp = 0
    local int i = 1
    from i = 1 do
        write(smallestMultiple)
        call lcm(smallestMultiple, i, tmp)
        tmp <=> smallestMultiple
        push(tmp, garbage)

        i += 1

    until i = 20
    delocal int i = 20
    delocal int tmp = 0

    write(smallestMultiple)

// Calculate least common multiple
// uses lcm(a, b) * gcd(a, b) = a * b
procedure lcm(int a, int b, int result)
    local int gcd = 0
        call gcd(a, b, gcd)

        result += (a * b) / gcd
    delocal int gcd = (a * b) / result

// Calculate greatest common divisor
// uses Euclidian Algorithm
procedure gcd(int a, int b, int result)
    if b = 0 then
        result += a
    else
        local int h = a % b
            call gcd(b, h, result)
        delocal int h = a % b
    fi b = 0
