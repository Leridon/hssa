// Problem 1 – Multiples of 3 and 5
// If we list all the natural numbers below 10 that are multiples of 3 or 5, we get 3, 5, 6 and 9. The sum of these multiples is 23.
// Find the sum of all the multiples of 3 or 5 below 1000.

procedure main()
    int result

    local int thousand = 1000
        call sumMultiplesUpTo(thousand, result)
    delocal int thousand = 1000

    write(result)


procedure sumMultiplesUpTo(int n, int sum)
  local int i = 1
  from i = 1 do

    if i % 3 = 0 || i % 5 = 0 then
        sum += i
    fi i % 3 = 0 || i % 5 = 0

    i += 1

  until i = n
  delocal int i = n
