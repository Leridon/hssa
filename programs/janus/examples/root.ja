////////////////////////////////////////////////////////////////////////
// root.ja:
//      An adapted version of the example program from "Janus: a time-
//      reversible language" by C. Lutz and H. Derby (1986)
//
// 31. Mar. 2020
////////////////////////////////////////////////////////////////////////

procedure root(int num, int root)
    local   int bit = 1

    from    bit = 1
    loop    call doublebit(bit)
    until   (bit * bit) > num

    from    (bit * bit) > num
    do      uncall doublebit(bit)
            if      ((root + bit) * (root + bit)) <= num
            then    root += bit
            fi      ((root / bit) % 2) != 0
    until   bit = 1

    delocal int bit = 1
    num -= root * root

procedure doublebit(int bit)
    local   int z = bit
    bit += z
    delocal int z = bit / 2

procedure main()
    int result
    int num

    read(num)
    call root(num, result)
    write(result)