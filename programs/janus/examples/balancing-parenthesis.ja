////////////////////////////////////////////////////////////////////////
// balancing-parenthesis.ja:
//      Reads one line from the input and counts the difference between
//      opening and closing parenthesis.
//
// N. Deworetzki, 24. Apr. 2020
////////////////////////////////////////////////////////////////////////

procedure main()
    stack input
    int result

    call readInput(input)
    call calculateBalance(input, result)
    write(result)

procedure calculateBalance(stack input, int balance)
    if      empty(input)
    else    local   int current = 0
            pop(current, input)

            if  current = '(' then
                balance += 1
            else if current = ')' then
                balance -= 1
            fi  current = ')'
            fi  current = '('

            call calculateBalance(input, balance)

            push(current, input)
            delocal int current = 0
    fi      empty(input)



procedure readInput(stack input)
    local   int in = 0

    from empty(input) do
        readc(in)
    loop
        push(in, input)
    until in = '\n'

    delocal int in = '\n'
