////////////////////////////////////////////////////////////////////////
// factor.ja:
//      An adapted version of the example program from "Janus: a time-
//      reversible language" by C. Lutz and H. Derby (1986)
//
// 31. Mar. 2020
////////////////////////////////////////////////////////////////////////

procedure factor(int num, int fact[20])
    local   int try = 0
    local   int i = 0

    from (try = 0) && (num > 1)
    loop
        call nexttry(try)
        from fact[i] != try
        loop
            i += 1
            fact[i] += try

            local   int z = num / try
            z <=> num
            delocal int z = num * try

        until (num % try) != 0
    until (try * try) > num // Exit early if possible

    if num != 1
    then
        i += 1          // Store the prime
        fact[i] <=> num // And zero num
    else
        num -= 1
    fi fact[i] != fact[i - 1]

    if (fact[i - 1] * fact[i - 1]) < fact[i]
    then
        from (try * try) > fact[i]
        loop
            uncall nexttry(try)
        until try = 0
    else
        try -= fact[i - 1]
    fi (fact[i - 1] * fact[i - 1]) < fact[i]

    call zeroi(fact, i)
    delocal int i = 0
    delocal int try = 0

procedure zeroi(int fact[20], int i)
    from fact[i + 1] = 0
    loop
        i -= 1
    until i = 0

procedure nexttry(int try)
    try += 2
    if try = 4
    then
        try -= 1
    fi try = 3

procedure main()
    int fact[20] // Factor table.  Starts zero. Ends with factors in ascending order

    local int num = 0
    read(num)
    call factor(num, fact)
    delocal int num = 0