data Nat = Z | S Nat

double :: Nat <-> Nat
double Z = Z
double S x =
  let x' = double x
  in S (S x')

plus :: Nat -> Nat <-> Nat
plus Z x = x
plus (S y) x =
  let x' = plus y x
  in (S x')

fib :: Nat <-> (Nat, Nat)
fib Z     = ((S Z),Z)
fib (S m) =
  let (x,y) = fib m
         y' = plus x y
  in (y',x)